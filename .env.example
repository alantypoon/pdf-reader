# ── Data paths ─────────────────────────────────────────────
PATH_DATA=/var/www/html/pdf-reader/data
PATH_TEXTBOOKS=${PATH_DATA}/textbooks
PATH_PASTPAPERS=${PATH_DATA}/past-papers

MONGODB_URI=

# ── DSE Auth (cookie validation) ──
DSE_AUTH_CONFIG_PATH=/var/www/html/auth-login/dse-auth-config.php
HTPASSWD_FILE=/etc/nginx/.htpasswd_dse

AVAILABLE_MODELS_PATH=/var/www/html/aigateway/available-models.json
AVAILABLE_PROVIDERS_PATH=/var/www/html/aigateway/available-providers.json

# ── Text extraction (image → text) via AI Gateway ett-vllm ──
VLLM_API_URL=https://gentle.aied.hku.hk/api/generate
VLLM_PROVIDER=ett-vllm
VLLM_MODEL=OpenGVLab/InternVL3_5-38B
VLLM_APIKEY=

# AIGATEWAY_MODEL_VLLM=

# ── Content generation (text → study materials) via Ollama ──
OLLAMA_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_APIKEY=
GATEWAY_EXTERNAL_URL=/aigateway/
GATEWAY_INTERNAL_URL=http://127.0.0.1:18084
